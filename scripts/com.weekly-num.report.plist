<?xml version="1.0" encoding="UTF-8"?>
<!--
  weekly-num 주간 리포트 자동 실행 (매주 수요일 20:00)

  설치는 scripts/install-launchd.sh 를 쓰십시오. __PROJECT_DIR__ 자리에
  실제 경로가 채워진 파일이 ~/Library/LaunchAgents/ 로 복사됩니다.

  놓친 실행에 대하여 (man launchd.plist 기준)

  - 잠자기(sleep) 중 예약 시각이 지나면 → 깨어난 직후 실행됩니다 (문서 보장).
  - 완전히 종료(shutdown)된 상태였다면 → 보장되지 않습니다. 부팅 시 launchd 는
    에이전트를 새로 로드할 뿐 지나간 캘린더 이벤트를 되짚지 않습니다.

  그래서 RunAtLoad 를 켭니다. 로그인/부팅 때마다 한 번 실행되므로, 맥을 꺼둔 채
  수요일 밤을 넘겼어도 다음에 켤 때 리포트가 나갑니다. 대신 두 가드가 붙습니다.

    1. draw_already_passed()  — 추첨이 지난 회차는 보내지 않는다
    2. deliveries 테이블      — 이미 보낸 회차는 다시 보내지 않는다

  이 둘이 없으면 로그인할 때마다 같은 메시지가 날아갑니다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.weekly-num.report</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/.venv/bin/weekly-num</string>
        <string>report</string>
        <string>--send</string>
        <string>--quiet</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>3</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/report.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/report.err.log</string>

    <!-- 종료 상태에서 예약을 놓친 경우를 위한 따라잡기. 중복 발송은
         deliveries 테이블과 추첨일 가드가 막는다. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
