# 이 파일은 "키 이름"만 담습니다. 실제 값은 .env 에 두고 절대 커밋하지 마십시오.
# 사용법:  cp .env.example .env  후 값 채우기

# --- Telegram (PRD F4-4) ---
# 1) 텔레그램에서 @BotFather 에게 /newbot  → 봇 토큰 발급
# 2) 생성한 봇과 대화 시작 후 아래로 chat_id 확인:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 토큰이 비어 있으면 파일 출력(FileNotifier)만 동작하고 경고를 남깁니다.
